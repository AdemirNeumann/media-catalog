generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  name String

  email String @unique

  password String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}