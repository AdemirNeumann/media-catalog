generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  role            Role            @default(USER)
  createdContents Content[]       @relation("CreatedContents")
  favorites       Favorite[]
  reviews         Review[]
  progress        WatchProgress[]
}

model Content {
  id          String          @id @default(uuid())
  title       String
  description String?
  type        MediaType
  status      ContentStatus
  releaseYear Int?
  coverUrl    String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("CreatedContents", fields: [createdById], references: [id])
  favorites   Favorite[]
  reviews     Review[]
  progress    WatchProgress[]
  genres      Genre[]         @relation("ContentToGenre")
}

model Genre {
  id       String    @id @default(uuid())
  name     String    @unique
  contents Content[] @relation("ContentToGenre")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Content  @relation(fields: [contentId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, contentId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  contentId String
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, contentId])
}

model WatchProgress {
  id             String        @id @default(uuid())
  currentEpisode Int?
  currentChapter Int?
  status         ContentStatus
  userId         String
  contentId      String
  content        Content       @relation(fields: [contentId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@unique([userId, contentId])
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  MOVIE
  ANIME
  DONGHUA
  BOOK
  MANHUA
  MANGA
  SERIES
}

enum ContentStatus {
  WATCHING
  COMPLETED
  DROPPED
  PLAN_TO_WATCH
}
